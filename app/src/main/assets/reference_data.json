  "gesetze_und_vorschriften": [
    {
      "titel": "Amateurfunkgesetz (AFuG § 2)",
      "paragraph": "§ 2 Begriffsbestimmungen",
      "inhalt": "Der Amateurfunkdienst ist ein Funkdienst, der von Funkamateuren untereinander, für die eigene Ausbildung und für technische Studien wahrgenommen wird. Funkamateure handeln aus persönlichem Interesse und ohne wirtschaftlichen Zweck."
    },
    {
      "titel": "Amateurfunkverordnung (AFuV § 16)",
      "paragraph": "§ 16 Rufzeichen und Betriebsabwicklung",
      "inhalt": "Zu Beginn und am Ende jeder Funkverbindung sowie mindestens alle 10 Minuten während einer länger andauernden Verbindung ist das zugeteilte personengebundene Rufzeichen deutlich auszusenden."
    },
    {
      "titel": "Amateurfunkverordnung (AFuV § 9)",
      "paragraph": "§ 9 Zulassung zur Teilnahme am Amateurfunkdienst",
      "inhalt": "Die Zulassung berechtigt zur Nutzung der den jeweiligen Klassen (N, E, A) zugeteilten Frequenzbereiche mit den festgelegten Sendeleistungen. Inhaber der Klasse E dürfen die Bänder 160m, 80m, 15m, 10m, 2m und 70cm nutzen."
    },
    {
      "titel": "BEMFV (Elektromagnetische Verträglichkeit)",
      "paragraph": "§ 9 Anzeige ortsfester Amateurfunkstellen",
      "inhalt": "Stationen, die eine äquivalente isotrope Strahlungsleistung (EIRP) von 10 Watt oder mehr aussenden, müssen vor Inbetriebnahme der Bundesnetzagentur eine Selbsterklärung anzeigen."
    },
    {
      "titel": "Drittverkehrsverbot",
      "paragraph": "AFuG § 5",
      "inhalt": "Nachrichten dürfen im Amateurfunkdienst nur für und an andere Funkamateure übermittelt werden. Die Übermittlung von Nachrichten für oder von Dritten ist im Inland und grenzüberschreitend unzulässig, es sei denn, im Not- und Katastrophenfunkfall."
    }
  ],
